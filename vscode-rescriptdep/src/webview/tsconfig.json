{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"skipLibCheck": true
	},
	"include": [
		"./**/*.ts",
		"../protocol.ts"
	]
}
