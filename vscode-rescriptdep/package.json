{
  "name": "vscode-bibimbob",
  "displayName": "Bibimbob",
  "description": "Visualize ReScript module dependencies, inspect focused graphs, and find unused modules",
  "version": "0.10.0",
  "packageManager": "pnpm@10.33.0",
  "publisher": "mununki",
  "license": "MIT",
  "icon": "images/rescriptdep_icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mununki/rescriptdep.git"
  },
  "homepage": "https://github.com/mununki/rescriptdep",
  "bugs": {
    "url": "https://github.com/mununki/rescriptdep/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "rescript",
    "reasonml",
    "dependency",
    "graph",
    "visualization",
    "unused-code"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/bsconfig.json",
    "workspaceContains:**/rescript.json"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**/*",
    "bin/**/*",
    "images/**/*",
    "package.json",
    "README.md",
    "LICENSE.md",
    "ThirdPartyNotices.txt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bibimbob.showDependencyGraph",
        "title": "Show Dependency Graph",
        "category": "Bibimbob"
      },
      {
        "command": "bibimbob.focusModuleDependencies",
        "title": "Focus On Module Dependencies",
        "category": "Bibimbob",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bibimbob.showUnusedModules",
        "title": "Show Unused Modules",
        "category": "Bibimbob"
      },
      {
        "command": "bibimbob.toggleValueUsageCount",
        "title": "Toggle Value Usage Count",
        "category": "Bibimbob"
      },
      {
        "command": "bibimbob.graph.openModule",
        "title": "Open Module"
      },
      {
        "command": "bibimbob.graph.focusModule",
        "title": "Focus on Module"
      },
      {
        "command": "bibimbob.graph.copyModuleName",
        "title": "Copy Module Name"
      },
      {
        "command": "bibimbob.graph.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "bibimbob.graph.fitToView",
        "title": "Fit to View"
      },
      {
        "command": "bibimbob.graph.back",
        "title": "Back"
      },
      {
        "command": "bibimbob.graph.showFullGraph",
        "title": "Show Full Graph"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bibimbob.focusModuleDependencies",
          "when": "resourceExtname == .res",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "bibimbob.graph.openModule",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'module' && bibimbobOpenable",
          "group": "1_navigation@1"
        },
        {
          "command": "bibimbob.graph.focusModule",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'module' && !bibimbobIsCenter",
          "group": "1_navigation@2"
        },
        {
          "command": "bibimbob.graph.copyModuleName",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'module'",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "bibimbob.graph.copyRelativePath",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'module' && bibimbobOpenable",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "bibimbob.graph.fitToView",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'canvas'",
          "group": "1_view@1"
        },
        {
          "command": "bibimbob.graph.back",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'canvas' && bibimbobCanGoBack",
          "group": "2_navigation@1"
        },
        {
          "command": "bibimbob.graph.showFullGraph",
          "when": "webviewId == 'bibimbobVisualizer' && webviewSection == 'canvas' && bibimbobMode != 'full'",
          "group": "2_navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "bibimbob.graph.openModule",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.focusModule",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.copyModuleName",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.copyRelativePath",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.fitToView",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.back",
          "when": "false"
        },
        {
          "command": "bibimbob.graph.showFullGraph",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Bibimbob",
      "properties": {
        "bibimbob.valueUsageCount.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show how often the value bound on the cursor line (`let`/`and`) is used, as an inline `Used N times` note in `.res` files. **Bibimbob: Toggle Value Usage Count** switches this setting."
        }
      }
    }
  },
  "screenshots": [
    {
      "path": "images/rescriptdep_screenshot_0.png",
      "description": "ReScript Dependency Graph Overview"
    },
    {
      "path": "images/rescriptdep_screenshot_1.png",
      "description": "ReScript Module Dependencies View"
    },
    {
      "path": "images/rescriptdep_screenshot_2.png",
      "description": "Inline Value Usage Count Annotation"
    }
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit && tsc -p src/webview/tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "esbuild src/test/unit/*.test.ts --bundle --platform=node --format=cjs --target=node20 --outdir=out/unit --alias:vscode=./src/test/unit/stub/vscode.ts --loader:.dot=text --log-level=warning && node --test out/unit/*.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@viz-js/viz": "3.12.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}
